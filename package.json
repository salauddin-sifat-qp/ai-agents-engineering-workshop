{
  "name": "ai-agents-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "Hands-on workshop: building an AI agent harness from a single LLM call up to a production-shaped runtime.",
  "type": "module",
  "scripts": {
    "01": "pnpm --filter 01-basic-llm start",
    "02": "pnpm --filter 02-tool-calling start",
    "03": "pnpm --filter 03-agent-loop start",
    "04": "pnpm --filter 04-state start",
    "05": "pnpm --filter 05-tools-and-edit start",
    "05:naive": "pnpm --filter 05-tools-and-edit naive",
    "05:edit": "pnpm --filter 05-tools-and-edit run edit",
    "06": "pnpm --filter 06-context start",
    "06:resume": "pnpm --filter 06-context resume",
    "06:fork": "pnpm --filter 06-context fork",
    "07": "pnpm --filter 07-mcp start:external",
    "07:server": "pnpm --filter 07-mcp start:stdio",
    "07:connect": "pnpm --filter 07-mcp connect",
    "08": "pnpm --filter 08-sub-agent start",
    "09": "pnpm --filter 09-policy start",
    "09:unguarded": "pnpm --filter 09-policy unguarded",
    "09:errors": "pnpm --filter 09-policy errors",
    "10": "pnpm --filter 10-trace-and-eval start",
    "10:eval": "pnpm --filter 10-trace-and-eval eval",
    "harness": "pnpm --filter harness start",
    "golden": "pnpm --filter harness golden",
    "verify": "tsx scripts/verify.ts",
    "snapshot": "tsx scripts/snapshot-help.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
